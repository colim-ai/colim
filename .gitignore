# Reservoir snapshot: 71 MB, and re-clonable exactly from the commit pinned in
# config.toml (census.index_commit). Provenance lives in the pin, not in git.
data/raw/reservoir-index/

# Build trees for the campaign set are kept on disk for debuggability, never committed.
work/
build/

# Ledger is regenerable from the pinned snapshot + cached GitHub fetch.
# Publishable numbers ship as exported reports, not as a binary blob in git.
ledger/*.sqlite
ledger/*.sqlite-wal
ledger/*.sqlite-shm

__pycache__/
*.pyc

# Reservoir build logs: 501 files, refetchable via harness/fetch_all_logs.py
# from the job URLs already recorded in the ledger.
data/raw/logs/
# Local build transcripts from the harness; hashes live in the ledger.
data/build_logs/

# Pinned upstream source trees for rename extraction. Re-clonable exactly:
#   git clone --depth 1 --branch v4.32.1 \
#     https://github.com/leanprover-community/mathlib4 data/raw/sources/mathlib-v4.32.1
# The extracted map (fixers/tier1/renames.json) IS committed -- it is the
# tier-1 input and must be versioned.
data/raw/sources/
